  "scripts": {
    "dev": "react-router dev --port 3000",
    "dev.open": "react-router dev --open",
    "build": "react-router build && vite -c vite.mikro-orm.config.ts build",
    "start": "NODE_ENV=production node ./build/server/index.js",
    "demo.start": "docker compose -f compose.demo.yaml --env-file .env.demo.local up --wait -d",
    "demo.stop": "docker compose -f compose.demo.yaml --env-file .env.demo.local down",
    "lint.types": "tsc --noEmit",
    "test": "vitest run --bail 1",
    "test.browser": "vitest --workspace=vitest.workspace.ts",
    "prepare": "node --no-warnings --experimental-strip-types .husky/install.ts",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
  "imports": {
    "#app/*": [
      "./app/*"
    ],
    "#tests/*": [
      "./tests/*"
    ]
  },
  "mikro-orm": {
    "configPaths": [
      "./app/server/lib/db/configs/dev.ts",
      "./build/db/mikro-orm.config.js"
    ],
    "tsLoader": "tsimp"
  },
